# Google Gemini AI (Nativo no AI Studio / Gratuito)
GEMINI_API_KEY=

# Google Maps Platform API Key (Places API New, Maps JS, Geocoding, Geogrid)
VITE_GOOGLE_MAPS_API_KEY=

# Outscraper API Key (Auditoria Real Google Meu Negocio: Verificado/Nao Verificado)
OUTSCRAPER_API_KEY=

# NVIDIA NIM API Key (Modelos Gratuitos NVIDIA Build: Llama 3.3 70B, DeepSeek R1)
NVIDIA_API_KEY=

# OpenRouter API Key (Modelos 100% Gratuitos OpenRouter: Llama 3.3 Free, DeepSeek R1)
OPENROUTER_API_KEY=

# Groq API Key (Inferencia Ultra Rapida Gratuita Llama 3.3 70B / Mixtral)
GROQ_API_KEY=

# Serper.dev API Key (Pesquisa Google SERP em Tempo Real - Plano Gratuito)
SERPER_API_KEY=
